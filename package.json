{
  "name": "open-photo-booth",
  "productName": "Open Photo Booth",
  "version": "0.1.0",
  "description": "Free, open-source photo booth for Windows and macOS.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "e2e": "node e2e.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.openphotobooth.app",
    "productName": "Open Photo Booth",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "editor.js",
      "layout.js",
      "templates/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Open Photo Booth uses the camera to take photos of your guests."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Open-Photo-Booth-${version}-${os}-${arch}.${ext}"
  },
  "author": "Open Photo Booth contributors",
  "homepage": "https://github.com/robert-schmidt/open-photo-booth",
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-schmidt/open-photo-booth.git"
  }
}
